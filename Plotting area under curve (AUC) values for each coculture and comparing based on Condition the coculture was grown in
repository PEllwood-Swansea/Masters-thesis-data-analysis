library(stringr)
library(scales)


#auc method
raw <- read.csv("combined_reshape_finished.csv", encoding = "latin1") %>%
  mutate(
    coculture = iconv(as.character(coculture), "", "ASCII", sub = ""),
    coculture = gsub("[–—−‐-‒]", "-", coculture),
    coculture = gsub("\\s+", "", coculture)
  ) %>%
  filter(grepl("^S\\d+-S\\d+$", coculture))

# 2. AUC calculation function- following the trapezoidal rule
calculate_auc <- function(df) {
  df <- df[order(df$Time), ]
  auc <- sum(diff(df$Time) * (head(df$area, -1) + tail(df$area, -1)) / 2, na.rm = TRUE)
  return(auc)
}

# 3. AUC per replicate (Condition + Coculture + Object_ID)
auc_data <- raw %>%
  group_by(Condition, coculture, Object_ID) %>%
  summarise(
    AUC = calculate_auc(cur_data()),
    .groups = "drop"
  )

# 4. Summary: Mean ± SE per coculture per condition
auc_summary <- auc_data %>%
  group_by(Condition, coculture) %>%
  summarise(
    mean_auc = mean(AUC, na.rm = TRUE),
    se_auc   = sd(AUC, na.rm = TRUE) / sqrt(n()),
    .groups = "drop"
  ) %>%
  mutate(
    starter = str_extract(coculture, "^S\\d+"),
    partner = sub("^S\\d+-(S\\d+)$", "\\1", coculture),
    starter_block = as.integer(factor(starter, levels = paste0("S", 1:12))),
    partner_pos   = as.integer(factor(partner, levels = paste0("S", 1:12)))
  )

# 5. Space out different cocultures
block_width <- 12
gap_width   <- 2
auc_summary <- auc_summary %>%
  mutate(
    x = (starter_block - 1) * (block_width + gap_width) + partner_pos
  )

# 6. Define axis and vertical separators - this should make it easier to read which coculture the data point is attributed too
x_breaks <- auc_summary$x
x_labels <- auc_summary$coculture
vlines   <- ((0:12)*(block_width+gap_width)) + 0.5
auc_summary <- auc_summary %>%
  mutate(label_short = gsub("S", "", coculture))  # e.g., "S1-S3" → "1-3"



# Rename conditions before plotting
auc_summary <- auc_summary %>%
  mutate(Condition = recode(Condition,
                            "0.0000135 mmol/L FeSO4,7H20" = "Medium Iron",
                            "0.000027 mmol/L FeSO4,7H20" = "High Iron",
                            "0.005mmol/L NO3" = "Medium Nitrate",
                            "0.01mmol/L NO3" = "High Nitrate",
                            "0.0005 mmol/L PO4" = "Medium Phosphate",
                            "0.001 mmol/L PO4" = "High Phosphate",
                            "2.5mg/l_Cu" = "Medium Copper",
                            "5.0mg/l_Cu" = "High Copper",
                            "Control" = "Control"
  ))


ggplot(auc_summary, aes(x = x, y = mean_auc, color = Condition)) +
  geom_errorbar(aes(ymin = mean_auc - se_auc, ymax = mean_auc + se_auc), width = 0.2) +
  geom_point(size = 2) +
  scale_x_continuous(
    breaks = auc_summary$x,
    labels = auc_summary$coculture,
    expand = expansion(mult = c(0.01, 0.01))
  ) +
  scale_color_brewer(palette = "Set2") +
  labs(
    title = "Mean AUC ± SE for Cocultures by Condition",
    x = "Coculture",
    y = "AUC",
    color = "Condition"
  ) +
  theme_minimal(base_size = 14) +  # Increase base font size
  theme(
    axis.text.x = element_text(angle = 60, hjust = 1, size = 8, face = "bold"),  # Bigger, bold labels
    axis.title.x = element_text(margin = margin(t = 10)),  # Add spacing below x axis
    plot.margin = margin(10, 10, 40, 10),  # Extra space for axis text
    legend.position = "bottom"
  )
